PORT=3000

# MongoDB（与 docker-compose mongodb 服务一致，认证库为 admin）
MONGODB_URI=mongodb://mongo_user:mongo_pass123@127.0.0.1:27017/knowledge_hub?authSource=admin

# PostgreSQL（与 docker-compose postgres 服务一致）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# 表结构已由 init-scripts/postgresql/init.sql 创建，生产环境保持 false
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# Neo4j（与 docker-compose neo4j 服务一致：NEO4J_AUTH=neo4j/12345678）
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
